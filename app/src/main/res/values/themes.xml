<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Prepmate" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Prevent system/OS-level force dark from auto-darkening our UI, ensuring we rely strictly on Jetpack Compose and our WebView configurations -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Startup Splash Theme -->
    <style name="Theme.Prepmate.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/prepmate_blue</item>
        <item name="android:navigationBarColor">@color/prepmate_blue</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
