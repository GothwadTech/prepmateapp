# ---------------------------------------------------------------------------
# Prepmate web target
# ---------------------------------------------------------------------------
# The Prepmate web app this Android app loads. Also used to derive the trusted
# origin for camera / microphone / geolocation grants, so it must match the
# deployment the WebView is allowed to talk to.
#
# Copy this file to .env (git-ignored) for local builds.
TARGET_URL=https://gtwdmate.pages.dev
